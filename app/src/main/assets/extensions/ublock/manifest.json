{
  "manifest_version": 2,
  "name": "AdFree Shield Native",
  "version": "1.55.0",
  "description": "Deeply embedded high-efficiency ad and tracker blocker with Built-in Reader Engine",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "alarms",
    "proxy",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["darkreader.js", "readability.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ublock-embedded@browser.adfree"
    }
  }
}
